{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){4}(?:@\\d+\\.\\d+\\.\\d+)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "output": {},
    "envelope": {
      "type": "object",
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {},
              "source": {
                "type": "string"
              },
              "capturedAt": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value",
              "source",
              "capturedAt"
            ],
            "additionalProperties": false
          }
        },
        "reasoning": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "by": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "promptTokens": {
                "type": "number"
              },
              "completionTokens": {
                "type": "number"
              }
            },
            "required": [
              "by",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "insights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "by": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "confidence": {
                "type": "number"
              }
            },
            "required": [
              "text",
              "by",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "trace": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "stepId": {
                "type": "string"
              },
              "durationMs": {
                "type": "number"
              },
              "startedAt": {
                "type": "string"
              },
              "completedAt": {
                "type": "string"
              }
            },
            "required": [
              "command",
              "stepId",
              "startedAt",
              "completedAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "signals",
        "reasoning",
        "insights",
        "trace"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "durationMs": {
          "type": "number"
        },
        "strategyUsed": {
          "type": "string"
        },
        "versionUsed": {
          "type": "string"
        },
        "recipeRunId": {
          "type": "string"
        },
        "artifactPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "command",
    "status",
    "output"
  ],
  "additionalProperties": false,
  "$id": "https://framework-mcp.labre.app/schemas/command-result.schema.json"
}
